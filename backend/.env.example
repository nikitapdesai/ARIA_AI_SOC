# Copy this file to .env and adjust as needed. All values here are
# also the defaults the app falls back to if .env is missing entirely,
# so .env is optional for local development.

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Speeds up / raises rate limits on Sentence Transformers
# model downloads from the Hugging Face Hub. Get one free at
# https://huggingface.co/settings/tokens -- leave blank to skip (the
# app works fine without it, just prints a warning on first download).
HF_TOKEN=

# Host/port uvicorn binds to when NOT overridden on the command line
# (e.g. `uvicorn api.main:app --host $API_HOST --port $API_PORT`).
API_HOST=127.0.0.1
API_PORT=8002

# LangSmith tracing for the live-analysis LangGraph pipeline
# (agents/graph_pipeline.py). Optional -- the graph runs fine with
# these unset, it just won't show up in the LangSmith dashboard.
# Get a key at https://smith.langchain.com/settings.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=aria-soc-pipeline
