# Copy this file to .env and adjust as needed.
#
# Leave VITE_API_URL blank (or delete the line) for normal local dev --
# the app then uses relative /api/* paths, which the Vite dev server
# proxies to API_PROXY_TARGET below (see vite.config.ts). Set
# VITE_API_URL when the frontend and backend are NOT on the same
# origin (e.g. backend deployed elsewhere).
VITE_API_URL=

# Where the Vite dev server proxies /api/* to. Only matters for `npm
# run dev`; irrelevant once VITE_API_URL is set or the app is built.
API_PROXY_TARGET=http://localhost:8002
